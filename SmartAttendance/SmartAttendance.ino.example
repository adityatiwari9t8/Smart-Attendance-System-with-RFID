// ── Wi-Fi ────────────────────────────────────────────────────────────
#define WIFI_SSID        "YOUR_WIFI_NAME"
#define WIFI_PASSWORD    "YOUR_WIFI_PASSWORD"

// ── Google Apps Script Web-App URL (must end with /exec) ─────────────
#define GOOGLE_SCRIPT_URL \
  "https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec"

// ── Shared secret the Apps Script checks ────────────────────────────
#define API_KEY          "change-this-shared-secret"

// ── Hardware pins ────────────────────────────────────────────────────
#define PIN_LED_GREEN     13   // green LED  – attendance accepted
#define PIN_LED_RED       26   // red LED    – unknown card / duplicate
#define PIN_LED_BLUE      14   // blue LED   – network busy
#define PIN_BUZZER        25   // passive buzzer (tone()), 100 Ω series
#define PIN_BUTTON_RESET   4   // attendance-reset button, wired active-LOW
#define PIN_RFID_SS        5   // MFRC522 SDA/SS
#define PIN_RFID_RST      27   // MFRC522 RST (NOT GPIO21 – that's OLED SDA)
#define PIN_RFID_SCK      18
#define PIN_RFID_MISO     19
#define PIN_RFID_MOSI     23
#define PIN_OLED_SDA      21
#define PIN_OLED_SCL      22

// ── OLED ─────────────────────────────────────────────────────────────
#define OLED_SCREEN_WIDTH    128
#define OLED_SCREEN_HEIGHT    64
#define OLED_RESET_PIN        -1     // shares the ESP32 reset line
#define OLED_I2C_ADDRESS    0x3C
#define OLED_I2C_ADDRESS_ALT 0x3D

// ── Timing (milliseconds unless noted) ───────────────────────────────
#define WIFI_CONNECT_TIMEOUT_MS   15000
#define HTTP_REQUEST_TIMEOUT_MS    8000
#define TLS_HANDSHAKE_TIMEOUT_MS  15000
#define RESULT_DISPLAY_MS           900
#define SUCCESS_DISPLAY_MS          900
#define SUCCESS_BEEP_HOLD_MS        150
#define ERROR_BEEP_HOLD_MS          200
#define RESET_HOLD_MS              3000
#define BUTTON_RELEASE_WAIT_MS     5000
#define SAME_CARD_COOLDOWN_MS      3000
#define SUMMARY_DISPLAY_MS         3000
#define BUTTON_DEBOUNCE_MS           40
#define SYNC_QUEUE_LENGTH             4
#define OUTBOX_CAPACITY              60
#define UPLOAD_RETRY_MIN_MS        2000
#define UPLOAD_RETRY_MAX_MS       60000
#define WIFI_RECHECK_MS           20000
#define RESULT_BANNER_WINDOW_MS   20000
#define DAY_CHECK_INTERVAL_MS      1000
#define CLOCK_SYNC_WAIT_MS         5000
#define READER_POLL_MS               40
#define READER_HEALTH_CHECK_MS     5000
#define ENROLL_WINDOW_MS          15000

// ── Roster / UID limits ───────────────────────────────────────────────
#define MAX_STUDENTS    2
#define MAX_UID_LENGTH 15

// ── Buzzer tones ──────────────────────────────────────────────────────
#define TONE_SUCCESS_HZ  1500
#define TONE_SUCCESS_MS   150
#define TONE_ERROR_HZ     500
#define TONE_ERROR_MS     400
#define TONE_WIFI_OK_HZ  2000
#define TONE_WIFI_OK_MS   100

// ── NTP / Timezone ────────────────────────────────────────────────────
// India Standard Time (UTC+5:30, no DST).  Change if needed, e.g.:
//   "UTC0"  |  "EST5EDT,M3.2.0,M11.1.0"  |  "GMT0BST,M3.5.0/1,M10.5.0"
#define TZ_INFO       "IST-5:30"
#define NTP_SERVER_1  "pool.ntp.org"
#define NTP_SERVER_2  "time.google.com"

// Anything before Nov 2023 means the clock hasn't been set yet.
#define MIN_VALID_EPOCH 1700000000UL

